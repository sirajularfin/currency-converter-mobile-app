{
  "name": "CurrencyConverter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "cd android && ./gradlew assembleDebug && cd ..",
    "android:release": "cd android && ./gradlew assembleRelease && cd ..",
    "pod": "cd ios && pod install && cd ..",
    "ios": "react-native run-ios --simulator='iPhone 16 Pro Max'",
    "ios:dev": "react-native bundle --entry-file index.js --platform ios --dev true --bundle-output ios/main.jsbundle --assets-dest ios && react-native run-ios --simulator='iPhone 16 Pro Max' --configuration Debug",
    "ios:release": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios && react-native run-ios --configuration Release",
    "clean:package": "rm -rf node_modules && yarn install",
    "clean:ios": "rm -rf ios/build ios/Pods ios/Podfile.lock node_modules && rm -rf ~/Library/Developer/Xcode/DerivedData/* && yarn install",
    "clean:android": "rm -rf android/app/build android/build android/.gradle/* node_modules && yarn install",
    "clean:final": "yarn cache clean && rm -rf android/app/build android/build android/.gradle/* ios/build ios/Pods ios/Podfile.lock node_modules && rm -rf ~/Library/Developer/Xcode/DerivedData/* && yarn install",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prettier": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "postinstall": "cd ios && pod install && cd .. || echo 'Skipping iOS pods install (non-macOS system)'"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.81.5",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "i18next": "^25.6.1",
    "react": "19.1.0",
    "react-i18next": "^16.2.4",
    "react-native": "0.81.5",
    "react-native-bootsplash": "^6.3.11",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.6.0",
    "react-native-navigation-bar-color": "^2.0.2",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.18.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "^15.14.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-dotenv-import": "^3.0.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
